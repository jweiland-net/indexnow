{
	"name": "jweiland/indexnow",
	"description": "TYPO3 extension to inform various search engines over IndexNow endpoint about content updates",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"authors": [
		{
			"name": "Stefan Froemken",
			"email": "sfroemken@jweiland.net"
		},
		{
			"name": "Hoja Mustaffa Abdul Latheef",
			"email": "hlatheef@jweiland.net"
		}
	],
	"homepage": "https://jweiland.net",
	"require": {
		"typo3/cms-core": "^12.4.31 || ^13.4.12 || ^14.3"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.44",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^8.2 || ^9.0"
	},
	"replace": {
		"typo3-ter/indexnow": "self.version"
	},
	"autoload": {
		"psr-4": {
			"JWeiland\\IndexNow\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"JWeiland\\IndexNow\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"app-dir": ".Build",
			"extension-key": "indexnow",
			"version": "0.0.11",
			"web-dir": ".Build/Web"
		}
	}
}
